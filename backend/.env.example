# MongoDB
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
DB_NAME=appdb

# JWT (generate a strong random string)
JWT_SECRET=change-this-to-a-64-char-random-string

# Railway will set PORT automatically — do NOT set it here
# PUBLIC_BASE_URL must match your Railway domain (with https://)
PUBLIC_BASE_URL=https://your-app-name.up.railway.app

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
ADMIN_EMAILS=admin@example.com
ADMIN_TELEGRAMS=
LOW_STOCK_THRESHOLD=3

# Only needed for local dev, where the React dev server is on a different origin.
# In production the SPA is served by this same app, so leave this unset.
CORS_ORIGINS=http://localhost:3000
